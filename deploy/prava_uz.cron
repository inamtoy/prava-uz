# /etc/cron.d/prava_uz — har kuni 03:30 da zaxira (baza + media), 14 kun saqlanadi.
# O'rnatish: sudo cp deploy/prava_uz.cron /etc/cron.d/prava_uz && sudo chmod 644 /etc/cron.d/prava_uz
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
30 3 * * * prava /srv/prava_uz/deploy/backup.sh >> /var/log/prava_uz/backup.log 2>&1
