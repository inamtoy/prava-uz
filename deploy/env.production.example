# Serverdagi /srv/prava_uz/.env namunasi (chmod 600, egasi prava). Repoga qo'yilmaydi.
# SECRET_KEY yaratish: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=bu-yerga-uzun-tasodifiy-kalit
DEBUG=False
ALLOWED_HOSTS=prava.uz,www.prava.uz
CSRF_TRUSTED_ORIGINS=https://prava.uz,https://www.prava.uz

DB_ENGINE=postgres
DB_NAME=prava_uz
DB_USER=prava
DB_PASSWORD=bu-yerga-kuchli-parol
DB_HOST=localhost
DB_PORT=5432

# HTTPS (certbot) sozlangach o'zgartirmang. Sertifikat olinmaguncha vaqtincha False qilish mumkin.
SECURE_SSL_REDIRECT=True
# Birinchi haftada qisqa HSTS (masalan 3600), hammasi ishlagach 31536000
SECURE_HSTS_SECONDS=3600
